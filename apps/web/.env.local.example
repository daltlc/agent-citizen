NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=

# Optional: GitHub Personal Access Token for PR commenting
# When set, Citizen will post "Accepted/Rejected" comments on GitHub PRs
# when a project owner reviews a contribution.
# Create one at https://github.com/settings/tokens with `public_repo` scope.
# Recommended: use a dedicated bot account rather than a personal account.
GITHUB_TOKEN=

# Optional: Upstash Redis for rate limiting
# Without these, rate limiting is disabled (all requests allowed).
# Create a free Redis database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
